<Project>
  <!--
    Single switch for the target framework (plan D2 / Q1).
    Plan Q1 resolved: .NET 10 LTS (net10.0). A future move changes only this property (plus package bumps).
    The WPF App derives its TFM from it: $(AcsToolTfm)-windows.
  -->
  <PropertyGroup>
    <AcsToolTfm>net10.0</AcsToolTfm>
    <TargetFramework>$(AcsToolTfm)</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Pinned to the SDK major (not "latest") so a newer SDK on a runner or dev box cannot enable new rules (CI fix, CA1859). -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Company>AcsTool</Company>
    <Product>AcsTool</Product>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
