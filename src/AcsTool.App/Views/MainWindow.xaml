<Window x:Class="AcsTool.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AcsTool.App.Views"
        Title="{Binding Title}" Width="1280" Height="820" MinWidth="1100" MinHeight="700">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding Proxy.StartStopCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding Proxy.Feed.ClearCommand}" />
  </Window.InputBindings>
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding StatusText}" />
    </StatusBar>
    <Grid DockPanel.Dock="Top" Margin="4,4,4,0">
      <TextBlock Text="AcsTool" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="⚙ Settings" Click="Settings_Click" />
      </StackPanel>
    </Grid>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Banners.Banners}" Margin="4,2">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{Binding Kind, Converter={StaticResource BannerKindToBrush}}" Padding="6,3" Margin="0,1" CornerRadius="2">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="dismiss" Command="{Binding DismissCommand}" Padding="4,0" MinWidth="0" />
              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="4">
      <TabItem Header="Proxy">
        <v:ProxyView DataContext="{Binding Proxy}" />
      </TabItem>
      <TabItem Header="Simulator">
        <v:SimulatorView DataContext="{Binding Simulator}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
