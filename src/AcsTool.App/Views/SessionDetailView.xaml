<UserControl x:Class="AcsTool.App.Views.SessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <TextBlock Text="Select a session" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding Session, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
    <DockPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
      <StackPanel DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Margin="0,0,0,4">
        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="4,2">
          <Run Text="Session " /><Run Text="{Binding DeviceKey, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ClientEndpoint, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="4,0">
          <Run Text="Started " /><Run Text="{Binding StartedText, Mode=OneWay}" /><Run Text="   Duration " /><Run Text="{Binding DurationText, Mode=OneWay}" />
          <Run Text="   " /><Run Text="{Binding OutcomeText, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock Margin="4,0">
          <Run Text="Events: " /><Run Text="{Binding EventsText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding VersionText, Mode=OneWay}" />
          <Run Text="   → " /><Run Text="{Binding TargetUrl, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="4,0" Text="{Binding TlsText}" Visibility="{Binding TlsText, Converter={StaticResource NullToVisibility}}" />
        <TextBlock Margin="4,0" Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}"
                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Notes}" Margin="4,0,4,2">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource MutedBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" MinHeight="60" />
          <RowDefinition Height="5" />
          <RowDefinition Height="2*" MinHeight="80" />
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Exchanges}" SelectedItem="{Binding SelectedExchange}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="30" />
            <DataGridTextColumn Header="Request" Binding="{Binding RequestText}" Width="2*" />
            <DataGridTextColumn Header="Response" Binding="{Binding ResponseText}" Width="2*" />
            <DataGridTextColumn Header="ms" Binding="{Binding Milliseconds}" Width="50" />
          </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
        <TabControl Grid.Row="2" DataContext="{Binding SelectedExchange}">
          <TabItem Header="Summary">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Request" FontWeight="SemiBold" Margin="4" />
                <ItemsControl ItemsSource="{Binding RequestFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Response" FontWeight="SemiBold" Margin="4,8,4,4" />
                <ItemsControl ItemsSource="{Binding ResponseFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" Margin="4,8"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Headers">
            <DockPanel>
              <CheckBox DockPanel.Dock="Top" Margin="4" Content="Reveal Authorization"
                        IsChecked="{Binding DataContext.RevealAuthorization, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Header="Request headers">
                  <DataGrid ItemsSource="{Binding RequestHeaders}" IsReadOnly="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                      <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Response headers">
                  <DataGrid ItemsSource="{Binding ResponseHeaders}" IsReadOnly="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                      <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </GroupBox>
              </Grid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Raw">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                <CheckBox Content="Pretty" IsChecked="{Binding Pretty}" VerticalAlignment="Center" Margin="4,0" />
                <Button Content="Copy request" Command="{Binding DataContext.CopyRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Content="Copy response" Command="{Binding DataContext.CopyResponseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </StackPanel>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="5" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding RequestTruncatedBanner}" Background="#FFF3CD" Padding="4,1"
                           Visibility="{Binding RequestTruncatedBanner, Converter={StaticResource NullToVisibility}}" />
                <TextBox Grid.Row="1" Style="{StaticResource MonoTextBox}" Text="{Binding RequestDisplay, Mode=OneWay}" />
                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="3" Text="{Binding ResponseTruncatedBanner}" Background="#FFF3CD" Padding="4,1"
                           Visibility="{Binding ResponseTruncatedBanner, Converter={StaticResource NullToVisibility}}" />
                <TextBox Grid.Row="4" Style="{StaticResource MonoTextBox}" Text="{Binding ResponseDisplay, Mode=OneWay}" />
              </Grid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
