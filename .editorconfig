root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,xaml,json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true

# Library code: ConfigureAwait(false) is the convention (plan §3.8 rule 1); enforced by review, not by CA2007
dotnet_diagnostic.CA2007.severity = none
# LoggerMessage source-gen is a v1 polish item; plain ILogger calls are acceptable for the MVP
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Names mandated by the plan / CWMP spec (CwmpVersion.V1_0, ParameterAttribute, XsdTypes.String, ISessionStore.Get, IRandom.Next)
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none

[tests/**.cs]
# Test names follow Method_Scenario_Expected (plan §5.2)
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA5394.severity = none
